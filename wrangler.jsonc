// Cloudflare konfigurācija: statiska vietne + Worker (autorizācija, pieteikumi, administrācija).
// Deploy with: wrangler deploy
{
  "name": "libertas-website",
  "compatibility_date": "2026-11-09",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /materiali-zviedru* = materiāls tikai reģistrētiem (Worker pārbauda sesiju)
    "run_worker_first": ["/api/*", "/auth/*", "/materiali-zviedru*"],
    // nezināmām adresēm rāda 404.html (statuss 404)
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libertas-db",
      "database_id": "cc0d1f05-c764-4e16-8d56-ced6e8872eb1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "edza7112@gmail.com",
    "GOOGLE_CLIENT_ID": "107664836932-r5b9n8divtdlfbgel2v812q9vgj9ccm5.apps.googleusercontent.com",
    // Pieteikumu e-pastu sūtītājs (Resend, domēns libertas.study). Atslēga: secret RESEND_API_KEY
    "EMAIL_FROM": "Libertas <pieteikumi@libertas.study>"
  },
  "observability": { "enabled": true }
}
